<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.masterescala.comunidad-vip-extraer-pagos</string>

    <!-- Extrae pagos de la App Master Escala desde notas GHL con título
         'Pago recibido App Master Escala'. Modo incremental (contactos con
         dateUpdated <2h en el dump local). Escribe pagos.json que consume
         el dashboard. Idempotente. Python directo por consistencia. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__INSTALL_DIR__/extraer_pagos.py</string>
        <string>--hours</string>
        <string>2</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>8</integer></dict>
        <dict><key>Minute</key><integer>28</integer></dict>
        <dict><key>Minute</key><integer>48</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/logs/launchd-extraer-pagos.out.log</string>

    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/logs/launchd-extraer-pagos.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
