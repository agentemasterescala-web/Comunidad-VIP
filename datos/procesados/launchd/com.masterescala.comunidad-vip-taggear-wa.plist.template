<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.masterescala.comunidad-vip-taggear-wa</string>

    <!-- Detecta desde qué número de WhatsApp del negocio escribió el contacto
         (from/to en mensajes TYPE_WHATSAPP) y le agrega el tag correspondiente
         (wa-<últimos 4 dígitos>). Idempotente y no destructivo.
         Procesa solo contactos con phone y dateUpdated en las últimas 2h.
         Corre python directo (no bash) por consistencia con consolidar/taggear-ig. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__INSTALL_DIR__/taggear_wa_source.py</string>
        <string>--hours</string>
        <string>2</string>
        <string>--live</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>6</integer></dict>
        <dict><key>Minute</key><integer>16</integer></dict>
        <dict><key>Minute</key><integer>26</integer></dict>
        <dict><key>Minute</key><integer>36</integer></dict>
        <dict><key>Minute</key><integer>46</integer></dict>
        <dict><key>Minute</key><integer>56</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/logs/launchd-taggear-wa.out.log</string>

    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/logs/launchd-taggear-wa.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
